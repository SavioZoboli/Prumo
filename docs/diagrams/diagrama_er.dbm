<dbmodel pgmodeler-ver="1.2.2" use-changelog="false" max-obj-count="8"
	 gen-disabled-objs-code="false" show-sys-schemas-rects="true"
	 last-position="0,0" last-zoom="1"
	 default-schema="public" default-owner="postgres"
	 layers="Default layer"
	 active-layers="0"
	 layer-name-colors="#000000"
	 layer-rect-colors="#b4b4b4"
	 show-layer-names="false" show-layer-rects="false">
<database name="new_database" is-template="false" allow-conns="true">
</database>

<schema name="public" layers="0" fill-color="#e1e1e1" name-color="#000000" sql-disabled="true">
</schema>

<table name="Usuarios" layers="0" collapse-mode="2" max-obj-count="9" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="280" y="500"/>
	<column name="id" not-null="true"
	 identity-type="ALWAYS">
		<type name="smallint" length="0"/>
	</column>
	<column name="nome" not-null="true">
		<type name="varchar" length="30"/>
	</column>
	<column name="sobrenome" not-null="true">
		<type name="varchar" length="30"/>
	</column>
	<column name="email" not-null="true">
		<type name="varchar" length="60"/>
	</column>
	<column name="usuario" not-null="true">
		<type name="varchar" length="50"/>
	</column>
	<column name="senha" not-null="true">
		<type name="varchar" length="100"/>
	</column>
	<column name="perfil" not-null="true" default-value="&quot;USER&quot;">
		<type name="varchar" length="5"/>
	</column>
	<column name="ativo" default-value="true">
		<type name="boolean" length="0"/>
	</column>
	<constraint name="uq_usuario" type="uq-constr" table="public.&quot;Usuarios&quot;">
		<columns names="usuario" ref-type="src-columns"/>
	</constraint>
	<constraint name="pk_usuario" type="pk-constr" table="public.&quot;Usuarios&quot;">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_email" type="uq-constr" table="public.&quot;Usuarios&quot;">
		<columns names="email" ref-type="src-columns"/>
	</constraint>
</table>

<table name="Materiais" layers="0" collapse-mode="2" max-obj-count="7" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="780" y="300"/>
	<column name="id" not-null="true"
	 identity-type="ALWAYS">
		<type name="smallint" length="0"/>
	</column>
	<column name="nome" not-null="true">
		<type name="varchar" length="30"/>
	</column>
	<column name="codigo" not-null="true">
		<type name="varchar" length="20"/>
	</column>
	<column name="equipamento" not-null="true">
		<type name="varchar" length="20"/>
	</column>
	<column name="estoque_minimo" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="ativo" not-null="true" default-value="true">
		<type name="boolean" length="0"/>
	</column>
	<constraint name="pk_material" type="pk-constr" table="public.&quot;Materiais&quot;">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<table name="Movimentacoes" layers="0" collapse-mode="2" max-obj-count="7" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="760" y="580"/>
	<column name="id" not-null="true"
	 identity-type="ALWAYS">
		<type name="smallint" length="0"/>
	</column>
	<column name="data" not-null="true" default-value="current_timestamp">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="operacao" not-null="true">
		<type name="varchar" length="1"/>
	</column>
	<column name="motivo">
		<type name="text" length="0"/>
	</column>
	<column name="usuario_id" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="is_estornado" default-value="false">
		<type name="boolean" length="10"/>
	</column>
	<constraint name="Movimentacoes_pk" type="pk-constr" table="public.&quot;Movimentacoes&quot;">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<table name="Itens_Movimento" layers="0" collapse-mode="2" max-obj-count="3" z-value="0">

	</constraint>
</table>

<constraint name="fk_usuario_id" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="CASCADE" del-action="RESTRICT" ref-table="public.&quot;Usuarios&quot;" table="public.&quot;Movimentacoes&quot;">
	<columns names="usuario_id" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="fk_movimento_id" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="CASCADE" del-action="RESTRICT" ref-table="public.&quot;Movimentacoes&quot;" table="public.&quot;Itens_Movimento&quot;">
	<columns names="movimento_id" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="fk_material_id" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="CASCADE" del-action="RESTRICT" ref-table="public.&quot;Materiais&quot;" table="public.&quot;Itens_Movimento&quot;">
	<columns names="material_id" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="fk_operador_id" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="CASCADE" del-action="RESTRICT" ref-table="public.&quot;Usuarios&quot;" table="public.&quot;Logs_Perfil&quot;">
	<columns names="operador_id" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

<constraint name="fk_alvo_id" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="CASCADE" del-action="RESTRICT" ref-table="public.&quot;Usuarios&quot;" table="public.&quot;Logs_Perfil&quot;">
	<columns names="alvo_id" ref-type="src-columns"/>
	<columns names="id" ref-type="dst-columns"/>
</constraint>

